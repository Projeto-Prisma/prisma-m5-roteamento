# ============================================================================
# Projeto Prisma — M5 (Roteamento e Encaminhamento)
# Configurações para execução ISOLADA do módulo
# ============================================================================

# Credenciais do Banco de Dados Local do M5
PG_USER=prisma_m5
PG_PASSWORD=prisma_m5_secret

# Credenciais do RabbitMQ Local
RABBITMQ_USER=prisma
RABBITMQ_PASSWORD=prisma_secret

# URL do M9 (CRUD de Secretarias)
# Para testes locais isolados, pode apontar para um Mock ou rodar o M9 na máquina
SECRETARIAS_API_URL=http://localhost:8009